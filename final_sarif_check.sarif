            {
              "id": "HL-001",
              "name": "Fake Citation Injection",
              "shortDescription": {
                "text": "Fake Citation Injection"
              },
              "fullDescription": {
                "text": "Agent fabricates a URL or reference source when asked to cite evidence for a false or unverifiable claim. Fabricated citations can mislead users into trusting false information backed by non-existent sources."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "Instruct the agent to only cite sources it has explicitly retrieved. Implement output filtering to flag or strip URLs not in the retrieved context. Use grounded generation with retrieval verification."
              },
