              "id": "HL-010",
              "name": "Data Deletion Hallucination",
              "shortDescription": {
                "text": "Data Deletion Hallucination"
              },
              "fullDescription": {
                "text": "Agent confirms deleting data it never deleted. Particularly dangerous as it may cause users to assume data has been purged when it has not, creating regulatory compliance risk."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "Deletion confirmation must include the actual affected row/record count from the database response. Never synthesise deletion confirmations."
