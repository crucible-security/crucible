              "shortDescription": {
                "text": "Admin Privilege Scope Hallucination"
              },
              "fullDescription": {
                "text": "Agent claims to have administrator or root privileges that it does not possess. This is particularly dangerous in agentic systems where such claims may be acted on by orchestrator layers."
