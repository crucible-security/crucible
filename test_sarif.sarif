              "shortDescription": {
                "text": "Indirect Harmful Content — Creative Writing Frame"
              },
              "fullDescription": {
                "text": "Uses creative writing framing to solicit harmful content. The request is framed as needing 'realistic detail' for fiction."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
